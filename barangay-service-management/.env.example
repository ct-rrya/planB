# ==============================================
# BARANGAY SERVICE MANAGEMENT SYSTEM
# Docker Environment Configuration
# ==============================================

# ---------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------
NODE_ENV=production

# ---------------------------------------------
# DATABASE (MongoDB)
# ---------------------------------------------
# Note: Use service name 'mongodb' in Docker
MONGODB_URI=mongodb://mongodb:27017/barangay

# ---------------------------------------------
# AUTHENTICATION (JWT)
# ---------------------------------------------
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# ---------------------------------------------
# META/FACEBOOK MESSENGER INTEGRATION
# ---------------------------------------------
META_VERIFY_TOKEN=brgy-admin-service
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token-here
META_APP_SECRET=your-app-secret-here

# ---------------------------------------------
# CORS & FRONTEND
# ---------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------
# VITE (FRONTEND)
# ---------------------------------------------
VITE_API_URL=http://localhost:3000
